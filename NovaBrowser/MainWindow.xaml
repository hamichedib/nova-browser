<Window x:Class="NovaBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:cefSharp="clr-namespace:CefSharp.Wpf;assembly=CefSharp.Wpf"
        Title="Nova Browser"
        Width="1280" Height="800"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource NovaGradientBrush}"
        Foreground="{StaticResource NovaTextBrush}"
        Icon="AppIcon.ico">

    <Window.Resources>
        <!-- Navigation button style -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource NovaTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background"
                                        Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tab button style -->
        <Style x:Key="TabButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource NovaTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10,10,0,0"
                                Padding="{TemplateBinding Padding}"
                                Margin="2,4,2,0">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background"
                                        Value="#0FFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Address bar TextBox style -->
        <Style x:Key="AddressBarStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0FFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource NovaTextBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource NovaTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NovaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="addressBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="false"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="addressBorder" Property="BorderBrush"
                                        Value="{StaticResource NovaAccentBrush}" />
                                <Setter TargetName="addressBorder" Property="Background"
                                        Value="#1AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close tab button -->
        <Style x:Key="CloseTabButton" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource NovaMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="closeBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="0">
                            <TextBlock Text="✕"
                                       FontSize="11"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="closeBorder" Property="Background"
                                        Value="#33FF4444" />
                                <Setter Property="Foreground"
                                        Value="#FFFF6666" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Tab strip -->
            <RowDefinition Height="42" />
            <!-- Row 1: Navigation bar -->
            <RowDefinition Height="50" />
            <!-- Row 2: Browser content -->
            <RowDefinition Height="*" />
            <!-- Row 3: Status bar -->
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ===== TAB STRIP ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource NovaGradientBrush}"
                BorderBrush="{StaticResource NovaBorderBrush}"
                BorderThickness="0,0,0,1">
            <DockPanel Margin="4,0">
                <!-- New Tab button -->
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource NavButton}"
                        Content="＋"
                        FontSize="18"
                        ToolTip="New Tab (Ctrl+T)"
                        Click="NewTab_Click"
                        Margin="4,4,8,2" />
                <!-- Tab list -->
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TabBar"
                                Orientation="Horizontal" />
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== NAVIGATION BAR ===== -->
        <Border Grid.Row="1"
                Background="{StaticResource NovaGradientBrush}"
                BorderBrush="{StaticResource NovaBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <DockPanel>
                <!-- Navigation buttons -->
                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            Margin="0,0,8,0">
                    <Button x:Name="BtnBack"
                            Style="{StaticResource NavButton}"
                            Content="◀"
                            ToolTip="Back (Alt+Left)"
                            Click="Back_Click" />
                    <Button x:Name="BtnForward"
                            Style="{StaticResource NavButton}"
                            Content="▶"
                            ToolTip="Forward (Alt+Right)"
                            Click="Forward_Click" />
                    <Button x:Name="BtnRefresh"
                            Style="{StaticResource NavButton}"
                            Content="⟳"
                            FontSize="20"
                            ToolTip="Reload (F5)"
                            Click="Refresh_Click" />
                    <Button x:Name="BtnHome"
                            Style="{StaticResource NavButton}"
                            Content="⌂"
                            FontSize="20"
                            ToolTip="Home"
                            Click="Home_Click" />
                </StackPanel>

                <!-- Right-side buttons -->
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            Margin="8,0,0,0">
                    <Button x:Name="BtnBookmark"
                            Style="{StaticResource NavButton}"
                            Content="☆"
                            FontSize="18"
                            ToolTip="Add Bookmark"
                            Click="Bookmark_Click" />
                    <Button x:Name="BtnDownloads"
                            Style="{StaticResource NavButton}"
                            Content="↓"
                            FontSize="18"
                            ToolTip="Downloads"
                            Click="Downloads_Click" />
                    <Button x:Name="BtnSettings"
                            Style="{StaticResource NavButton}"
                            Content="⚙"
                            FontSize="16"
                            ToolTip="Settings"
                            Click="Settings_Click" />
                </StackPanel>

                <!-- Address bar -->
                <TextBox x:Name="AddressBar"
                         Style="{StaticResource AddressBarStyle}"
                         KeyDown="AddressBar_KeyDown"
                         GotFocus="AddressBar_GotFocus" />
            </DockPanel>
        </Border>

        <!-- ===== BROWSER CONTENT ===== -->
        <Grid x:Name="BrowserContainer" Grid.Row="2" />

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="3"
                Background="{StaticResource NovaPanelBrush}"
                BorderBrush="{StaticResource NovaBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0">
            <DockPanel>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{StaticResource NovaMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="StatusRight"
                           DockPanel.Dock="Right"
                           Text=""
                           Foreground="{StaticResource NovaMutedBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
