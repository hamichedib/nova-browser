<Application x:Class="NovaBrowser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Nova colour palette -->
        <Color x:Key="NovaBg0">#FF020010</Color>
        <Color x:Key="NovaBg1">#FF0A0119</Color>
        <Color x:Key="NovaBg2">#FF120830</Color>
        <Color x:Key="NovaBg3">#FF1A0E4A</Color>
        <Color x:Key="NovaAccent">#FF8A5CFF</Color>
        <Color x:Key="NovaAccent2">#FF4CD9FF</Color>
        <Color x:Key="NovaText">#FFEEF1FF</Color>
        <Color x:Key="NovaMuted">#9EEEF1FF</Color>
        <Color x:Key="NovaBorder">#598A5CFF</Color>
        <Color x:Key="NovaPanel">#8C120830</Color>

        <SolidColorBrush x:Key="NovaBg0Brush" Color="{StaticResource NovaBg0}" />
        <SolidColorBrush x:Key="NovaBg1Brush" Color="{StaticResource NovaBg1}" />
        <SolidColorBrush x:Key="NovaBg2Brush" Color="{StaticResource NovaBg2}" />
        <SolidColorBrush x:Key="NovaBg3Brush" Color="{StaticResource NovaBg3}" />
        <SolidColorBrush x:Key="NovaAccentBrush" Color="{StaticResource NovaAccent}" />
        <SolidColorBrush x:Key="NovaAccent2Brush" Color="{StaticResource NovaAccent2}" />
        <SolidColorBrush x:Key="NovaTextBrush" Color="{StaticResource NovaText}" />
        <SolidColorBrush x:Key="NovaMutedBrush" Color="{StaticResource NovaMuted}" />
        <SolidColorBrush x:Key="NovaBorderBrush" Color="{StaticResource NovaBorder}" />
        <SolidColorBrush x:Key="NovaPanelBrush" Color="{StaticResource NovaPanel}" />

        <LinearGradientBrush x:Key="NovaGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource NovaBg0}" Offset="0" />
            <GradientStop Color="{StaticResource NovaBg1}" Offset="0.45" />
            <GradientStop Color="{StaticResource NovaBg2}" Offset="1" />
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NovaAccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource NovaAccent}" Offset="0" />
            <GradientStop Color="{StaticResource NovaAccent2}" Offset="1" />
        </LinearGradientBrush>

        <!-- ToolTip style -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{StaticResource NovaPanelBrush}" />
            <Setter Property="Foreground" Value="{StaticResource NovaTextBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource NovaBorderBrush}" />
        </Style>
    </Application.Resources>
</Application>
